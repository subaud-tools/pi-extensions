{
  "name": "pi-copy",
  "version": "0.1.0",
  "description": "Copy one part of the last pi answer from its source text: a code block exactly as written, or the prose as plain text, through /copy-part and alt+c.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subaud-tools/pi-extensions.git",
    "directory": "packages/pi-copy"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "copy",
    "clipboard",
    "markdown"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test src/*.test.ts"
  },
  "dependencies": {
    "marked": "18.0.11"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "typescript": "^5.6.0"
  }
}
